{
  "name": "playwright-training",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "prepare": "husky install",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:ci": "playwright test --reporter=html",
    "test:report": "playwright show-report",
    "build:report": "mkdir -p public/playwright-report && cpx \"playwright-report/**/*\" public/playwright-report",
    "build": "npm run build:report",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.4.1",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "cpx": "^1.5.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.57.1"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
